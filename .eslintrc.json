{
  "root": true,
  "env": {
    "node": true,
    "es2021": true
  },
  "extends": [
    "eslint:recommended"
  ],
  "ignorePatterns": [
    "data/",
    "node_modules/"
  ],
  "overrides": [
    {
      "files": [
        "public/**/*.js"
      ],
      "env": {
        "browser": true,
        "es2021": true
      }
    }
  ],
  "rules": {
    "no-unused-vars": [
      "error",
      {
        "argsIgnorePattern": "^_",
        "varsIgnorePattern": "^_"
      }
    ]
  }
}
