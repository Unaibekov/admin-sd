<%- include('partials/head', { pageTitle }) %>
<div class="app-shell">
  <%- include('partials/sidebar', { activePage: 'reports', showDashboardLink }) %>

  <main class="app-main app-main-report-dashboard report-dashboard-page">
      <div class="report-dashboard-shell">
        <% const employeeOptions = Array.isArray(reportsPage && reportsPage.employees) ? reportsPage.employees : []; %>
        <% const selectedEmployeeKey = reportsPage && reportsPage.selectedEmployeeKey ? reportsPage.selectedEmployeeKey : ''; %>
        <% const reportContentModel = typeof reportsContent !== 'undefined' ? reportsContent : null; %>

        <% if (!reportsPage.hasEmployees) { %>
          <header class="report-dashboard-head">
            <div>
              <h1>Отчеты</h1>
              <p>Загрузите импортированный отчет, чтобы посмотреть сводную информацию.</p>
            </div>
          </header>
        <% } else { %>
          <header class="report-dashboard-head reports-page-head reports-page-toolbar" data-reports-filters>
            <div class="reports-page-toolbar-copy">
              <h1>Отчеты</h1>
              <p>Просмотр отчетов сотрудников.</p>
            </div>
            <form class="reports-filters-form reports-toolbar-form" method="get" action="/reports" aria-label="Фильтры отчетов">
              <label class="reports-filter-field">
                <span>Сотрудник</span>
                <select name="employee" data-reports-employee>
                  <% employeeOptions.forEach((employee) => { %>
                    <option value="<%= employee.key %>" <%= selectedEmployeeKey === employee.key ? 'selected' : '' %>>
                      <%= employee.label %>
                    </option>
                  <% }) %>
                </select>
              </label>
            </form>
          </header>

          <% if (reportContentModel) { %>
            <section class="report-kpi-grid" aria-label="Основные показатели">
              <% reportContentModel.kpis.forEach((metric) => { %>
                <article class="dashboard-stat dashboard-stat-<%= metric.key === 'problems' && metric.value > 0 ? 'warning' : 'dark' %>">
                  <span class="dashboard-stat-label"><%= metric.label %></span>
                  <strong><%= metric.value %></strong>
                </article>
              <% }) %>
            </section>

            <section class="report-sections-grid">
              <article class="dashboard-card report-section-card">
                <div class="dashboard-card-head">
                  <div>
                    <h2>Требуют внимания</h2>
                    <p>Только активные состояния выбранного отчета.</p>
                  </div>
                  <a class="dashboard-card-link" href="/journal?reportId=<%= encodeURIComponent(selectedReport.reportId) %>&category=problems">Показать все</a>
                </div>

                <% if (reportContentModel.issues.length) { %>
                  <div class="report-attention-list">
                    <% reportContentModel.issues.forEach((issue) => { %>
                      <% const issueRisk = issue.risk ? ` · ${issue.risk}` : ''; %>
                      <% const issueLocation = issue.location ? ` · ${issue.location}` : ''; %>
                      <% if (issue.href) { %>
                        <a class="report-attention-item report-attention-link" href="<%= issue.href %>">
                          <div class="report-attention-copy">
                            <strong><%= issue.title %></strong>
                            <span>Код: <%= issue.code %></span>
                            <span>Проблема: <%= issue.reason %><%= issueRisk %></span>
                            <span>Остаток: <%= issue.quantity %> растений</span>
                            <span>Стадия: <%= issue.stage %><%= issueLocation %></span>
                          </div>
                        </a>
                      <% } else { %>
                        <article class="report-attention-item">
                          <div class="report-attention-copy">
                            <strong><%= issue.title %></strong>
                            <span>Код: <%= issue.code %></span>
                            <span>Проблема: <%= issue.reason %><%= issueRisk %></span>
                            <span>Остаток: <%= issue.quantity %> растений</span>
                            <span>Стадия: <%= issue.stage %><%= issueLocation %></span>
                          </div>
                        </article>
                      <% } %>
                    <% }) %>
                  </div>
                <% } else { %>
                  <div class="dashboard-inline-empty">Активных проблем нет.</div>
                <% } %>
              </article>

              <article class="dashboard-card report-section-card">
                <div class="dashboard-card-head">
                  <div>
                    <h2>Работа по стадиям</h2>
                    <p>Текущее распределение партий и растений по стадиям.</p>
                  </div>
                  <a class="dashboard-card-link" href="/stages?reportId=<%= encodeURIComponent(selectedReport.reportId) %>&employee=<%= encodeURIComponent(reportsPage.selectedEmployeeKey) %>">Все партии</a>
                </div>

                <div class="report-stage-summary">
                  <% reportContentModel.stageSummary.forEach((item) => { %>
                    <a class="report-stage-row report-stage-link" href="<%= item.href %>">
                      <strong><%= item.stage %></strong>
                      <span><%= item.batchesCount %> партий</span>
                      <span><%= item.plantsCount %> растений</span>
                    </a>
                  <% }) %>
                </div>
              </article>

              <% if (reportContentModel.linkedBatches.length) { %>
                <article class="dashboard-card report-section-card">
                  <div class="dashboard-card-head">
                    <div>
                      <h2>Связанные партии</h2>
                      <p>Родительские и дочерние партии выбранного отчета.</p>
                    </div>
                  </div>

                  <div class="report-related-batches">
                    <% reportContentModel.linkedBatches.forEach((group) => { %>
                      <section class="report-related-group">
                        <div class="report-related-parent">
                          <% if (group.parent.href) { %>
                            <a href="<%= group.parent.href %>"><strong><%= group.parent.title %></strong></a>
                          <% } else { %>
                            <strong><%= group.parent.title %></strong>
                          <% } %>
                          <span><%= group.parent.code %></span>
                        </div>

                        <div class="report-related-children">
                          <% group.children.forEach((child) => { %>
                            <a class="report-related-child" href="<%= child.href %>">
                              <strong><%= child.title %></strong>
                              <span><%= child.code %> · <%= child.originLabel %> · <%= child.quantity %> шт.</span>
                            </a>
                          <% }) %>
                        </div>
                      </section>
                    <% }) %>
                  </div>
                </article>
              <% } %>

              <article class="dashboard-card report-section-card">
                <div class="dashboard-card-head">
                  <div>
                    <h2>Последние действия</h2>
                    <p>Последние события только из выбранного отчета.</p>
                  </div>
                  <a class="dashboard-card-link" href="/journal?reportId=<%= encodeURIComponent(selectedReport.reportId) %>">Показать все</a>
                </div>

                <%- include('partials/dashboard-event-feed', {
                  events: reportContentModel.recentEvents,
                  emptyText: 'В этом отчете пока нет событий.',
                  eventHref: function eventHref(event) { return event.href || ''; }
                }) %>
              </article>
            </section>
          <% } else { %>
            <div class="dashboard-inline-empty reports-selection-empty">У сотрудника пока нет доступных данных.</div>
          <% } %>
        <% } %>
      </div>
  </main>
</div>
<%- include('partials/footer') %>
