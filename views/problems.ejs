<%- include('partials/head', { pageTitle }) %>
<div class="app-shell">
  <%- include('partials/sidebar', { activePage: 'problems', showDashboardLink }) %>

  <main class="app-main app-main-report-dashboard report-dashboard-page" data-problems-page>
      <div class="report-dashboard-shell problems-page">
        <header class="report-dashboard-head reports-page-head">
          <div>
            <h1>Проблемы</h1>
            <p>Контроль состояния проблемных партий.</p>
          </div>
        </header>

        <% if (!problems.hasCases) { %>
          <section class="dashboard-card">
            <div class="dashboard-inline-empty">Проблемные партии появятся после загрузки отчетов с проблемными сценариями.</div>
          </section>
        <% } else { %>
          <section class="dashboard-card reports-filters-card" aria-label="Фильтры проблем">
            <form class="reports-filters-form problems-filters-form" method="get" action="/problems">
              <label class="reports-filter-field">
                <span>Сотрудник</span>
                <div class="batches-filter global-journal-dropdown" data-problems-filter>
                  <input type="hidden" name="employee" value="<%= problems.filters.employee %>" data-problems-filter-input>
                  <button type="button" class="batches-filter-toggle <%= problems.filters.employee !== 'all' ? 'has-value' : '' %>" data-problems-filter-toggle aria-expanded="false">
                    <span class="batches-filter-toggle-copy" data-problems-filter-label>
                      <%= (problems.filters.employeeOptions.find((option) => option.value === problems.filters.employee) || problems.filters.employeeOptions[0]).label %>
                    </span>
                  </button>
                  <nav class="batches-filter-menu global-journal-dropdown-menu-scroll" data-problems-filter-menu hidden aria-label="Фильтр по сотруднику">
                    <% problems.filters.employeeOptions.forEach((option) => { %>
                      <button
                        type="button"
                        class="batches-stage-filter-item <%= problems.filters.employee === option.value ? 'active' : '' %>"
                        data-problems-filter-option
                        data-value="<%= option.value %>"
                        data-label="<%= option.label %>">
                        <span><%= option.label %></span>
                      </button>
                    <% }) %>
                  </nav>
                </div>
              </label>

              <label class="reports-filter-field">
                <span>Тип проблемы</span>
                <div class="batches-filter global-journal-dropdown" data-problems-filter>
                  <input type="hidden" name="type" value="<%= problems.filters.type %>" data-problems-filter-input>
                  <button type="button" class="batches-filter-toggle <%= problems.filters.type !== 'all' ? 'has-value' : '' %>" data-problems-filter-toggle aria-expanded="false">
                    <span class="batches-filter-toggle-copy" data-problems-filter-label>
                      <%= (problems.filters.typeOptions.find((option) => option.value === problems.filters.type) || problems.filters.typeOptions[0]).label %>
                    </span>
                  </button>
                  <nav class="batches-filter-menu" data-problems-filter-menu hidden aria-label="Фильтр по типу проблемы">
                    <% problems.filters.typeOptions.forEach((option) => { %>
                      <button
                        type="button"
                        class="batches-stage-filter-item <%= problems.filters.type === option.value ? 'active' : '' %>"
                        data-problems-filter-option
                        data-value="<%= option.value %>"
                        data-label="<%= option.label %>">
                        <span><%= option.label %></span>
                      </button>
                    <% }) %>
                  </nav>
                </div>
              </label>

              <label class="reports-filter-field">
                <span>Риск</span>
                <div class="batches-filter global-journal-dropdown" data-problems-filter>
                  <input type="hidden" name="risk" value="<%= problems.filters.risk %>" data-problems-filter-input>
                  <button type="button" class="batches-filter-toggle <%= problems.filters.risk !== 'all' ? 'has-value' : '' %>" data-problems-filter-toggle aria-expanded="false">
                    <span class="batches-filter-toggle-copy" data-problems-filter-label>
                      <%= (problems.filters.riskOptions.find((option) => option.value === problems.filters.risk) || problems.filters.riskOptions[0]).label %>
                    </span>
                  </button>
                  <nav class="batches-filter-menu" data-problems-filter-menu hidden aria-label="Фильтр по риску">
                    <% problems.filters.riskOptions.forEach((option) => { %>
                      <button
                        type="button"
                        class="batches-stage-filter-item <%= problems.filters.risk === option.value ? 'active' : '' %>"
                        data-problems-filter-option
                        data-value="<%= option.value %>"
                        data-label="<%= option.label %>">
                        <span><%= option.label %></span>
                      </button>
                    <% }) %>
                  </nav>
                </div>
              </label>

              <label class="reports-filter-field">
                <span>Статус</span>
                <div class="batches-filter global-journal-dropdown" data-problems-filter>
                  <input type="hidden" name="status" value="<%= problems.filters.status %>" data-problems-filter-input>
                  <button type="button" class="batches-filter-toggle <%= problems.filters.status !== 'all' ? 'has-value' : '' %>" data-problems-filter-toggle aria-expanded="false">
                    <span class="batches-filter-toggle-copy" data-problems-filter-label>
                      <%= (problems.filters.statusOptions.find((option) => option.value === problems.filters.status) || problems.filters.statusOptions[0]).label %>
                    </span>
                  </button>
                  <nav class="batches-filter-menu" data-problems-filter-menu hidden aria-label="Фильтр по статусу">
                    <% problems.filters.statusOptions.forEach((option) => { %>
                      <button
                        type="button"
                        class="batches-stage-filter-item <%= problems.filters.status === option.value ? 'active' : '' %>"
                        data-problems-filter-option
                        data-value="<%= option.value %>"
                        data-label="<%= option.label %>">
                        <span><%= option.label %></span>
                      </button>
                    <% }) %>
                  </nav>
                </div>
              </label>

              <button type="submit" class="button reports-filter-submit">Показать</button>
            </form>
          </section>

          <section class="report-kpi-grid" aria-label="KPI проблем">
            <% problems.kpis.forEach((metric) => { %>
              <article class="dashboard-stat dashboard-stat-<%= metric.key === 'active' || metric.key === 'highRisk' ? 'warning' : 'dark' %>">
                <span class="dashboard-stat-label"><%= metric.label %></span>
                <strong><%= metric.value %></strong>
              </article>
            <% }) %>
          </section>

          <section class="problems-content <%= problems.groupedCases.rightSections.length ? 'problems-content-split' : '' %>">
            <article class="dashboard-card report-section-card">
              <div class="dashboard-card-head">
                <div>
                  <h2><%= problems.groupedCases.leftTitle %></h2>
                  <p><%= problems.groupedCases.leftDescription %></p>
                </div>
              </div>

              <% if (problems.groupedCases.leftSections.some((section) => section.cases.length)) { %>
                <div class="problems-column-sections">
                  <% problems.groupedCases.leftSections.forEach((section) => { %>
                    <% if (section.cases.length) { %>
                      <section class="problems-column-section">
                        <div class="problems-column-section-head">
                          <h3><%= section.title %></h3>
                          <span><%= section.cases.length %></span>
                        </div>
                        <div class="problems-case-list">
                          <% section.cases.forEach((problemCase) => { %>
                            <article class="problems-case-card problems-case-card-<%= problemCase.statusKey %>">
                              <div class="problems-case-head">
                                <div class="problems-case-title">
                                  <strong><%= problemCase.title %></strong>
                                  <span class="problems-case-status-text"><%= problemCase.headerStatus %></span>
                                </div>
                              </div>

                              <div class="problems-case-meta-line" aria-label="Сводка по партии">
                                <% problemCase.metaLine.forEach((item, index) => { %>
                                  <span>
                                    <%= item %><%= index < problemCase.metaLine.length - 1 ? ' ·' : '' %>
                                  </span>
                                <% }) %>
                              </div>

                              <dl class="problems-case-facts">
                                <% problemCase.agronomyFields.forEach((field) => { %>
                                  <div class="problems-case-fact-row">
                                    <dt><%= field.label %></dt>
                                    <dd><%= field.value %></dd>
                                  </div>
                                <% }) %>
                              </dl>

                              <div class="problems-case-footer">
                                <div class="problems-case-last-action">
                                  <span>Последнее действие</span>
                                  <strong><%= problemCase.lastAction.title %></strong>
                                  <% if (problemCase.lastAction.atLabel) { %>
                                    <small><%= problemCase.lastAction.atLabel %></small>
                                  <% } %>
                                </div>

                                <div class="problems-case-actions">
                                  <a class="dashboard-card-link" href="<%= problemCase.journalUrl %>">Открыть журнал</a>
                                  <a class="dashboard-card-link" href="<%= problemCase.passportUrl %>">Открыть паспорт</a>
                                </div>
                              </div>
                            </article>
                          <% }) %>
                        </div>
                      </section>
                    <% } %>
                  <% }) %>
                </div>
              <% } else { %>
                <div class="dashboard-inline-empty">По выбранным фильтрам problem cases не найдены.</div>
              <% } %>
            </article>

            <% if (problems.groupedCases.rightSections.length) { %>
              <article class="dashboard-card report-section-card">
                <div class="dashboard-card-head">
                  <div>
                    <h2><%= problems.groupedCases.rightTitle %></h2>
                    <p><%= problems.groupedCases.rightDescription %></p>
                  </div>
                </div>

                <% if (problems.groupedCases.rightSections.some((section) => section.cases.length)) { %>
                  <div class="problems-column-sections">
                    <% problems.groupedCases.rightSections.forEach((section) => { %>
                      <% if (section.cases.length) { %>
                        <section class="problems-column-section">
                          <div class="problems-column-section-head">
                            <h3><%= section.title %></h3>
                            <span><%= section.cases.length %></span>
                          </div>
                          <div class="problems-case-list">
                            <% section.cases.forEach((problemCase) => { %>
                              <article class="problems-case-card problems-case-card-<%= problemCase.statusKey %>">
                                <div class="problems-case-head">
                                  <div class="problems-case-title">
                                    <strong><%= problemCase.title %></strong>
                                    <span class="problems-case-status-text"><%= problemCase.headerStatus %></span>
                                  </div>
                                </div>

                                <div class="problems-case-meta-line" aria-label="Сводка по партии">
                                  <% problemCase.metaLine.forEach((item, index) => { %>
                                    <span>
                                      <%= item %><%= index < problemCase.metaLine.length - 1 ? ' ·' : '' %>
                                    </span>
                                  <% }) %>
                                </div>

                                <dl class="problems-case-facts">
                                  <% problemCase.agronomyFields.forEach((field) => { %>
                                    <div class="problems-case-fact-row">
                                      <dt><%= field.label %></dt>
                                      <dd><%= field.value %></dd>
                                    </div>
                                  <% }) %>
                                </dl>

                                <div class="problems-case-footer">
                                  <div class="problems-case-last-action">
                                    <span>Последнее действие</span>
                                    <strong><%= problemCase.lastAction.title %></strong>
                                    <% if (problemCase.lastAction.atLabel) { %>
                                      <small><%= problemCase.lastAction.atLabel %></small>
                                    <% } %>
                                  </div>

                                  <div class="problems-case-actions">
                                    <a class="dashboard-card-link" href="<%= problemCase.journalUrl %>">Открыть журнал</a>
                                    <a class="dashboard-card-link" href="<%= problemCase.passportUrl %>">Открыть паспорт</a>
                                  </div>
                                </div>
                              </article>
                            <% }) %>
                          </div>
                        </section>
                      <% } %>
                    <% }) %>
                  </div>
                <% } else { %>
                  <div class="dashboard-inline-empty">По выбранным фильтрам решенные кейсы не найдены.</div>
                <% } %>
              </article>
            <% } %>
          </section>
        <% } %>
      </div>
  </main>
</div>
<%- include('partials/footer') %>
