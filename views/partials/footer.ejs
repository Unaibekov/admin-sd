<div class="lightbox" hidden aria-hidden="true">
  <button type="button" class="lightbox-backdrop" aria-label="Закрыть просмотр"></button>
  <section class="lightbox-panel photo-modal-panel" role="dialog" aria-modal="true" aria-label="Просмотр фото" tabindex="-1">
    <button type="button" class="lightbox-close" aria-label="Закрыть">&times;</button>
    <div class="photo-modal-layout">
      <div class="photo-modal-media">
        <img class="lightbox-image photo-modal-image" src="" alt="">
        <div class="photo-modal-navigation" data-photo-navigation hidden>
          <button type="button" class="photo-modal-nav" data-photo-prev aria-label="Предыдущее фото">&larr;</button>
          <span class="photo-modal-counter" data-photo-counter></span>
          <button type="button" class="photo-modal-nav" data-photo-next aria-label="Следующее фото">&rarr;</button>
        </div>
      </div>
      <div class="photo-modal-meta">
        <section class="photo-modal-summary">
          <p class="photo-modal-summary-meta" data-photo-meta hidden></p>
          <h2 class="photo-modal-summary-title" data-photo-title hidden></h2>
          <p class="photo-modal-summary-subtitle" data-photo-subtitle hidden></p>
        </section>

        <section class="photo-modal-details" data-photo-details-wrap hidden>
          <h3 class="photo-modal-details-title" data-photo-event hidden></h3>
          <dl class="photo-modal-details-grid" data-photo-details></dl>
        </section>

        <div class="photo-modal-actions">
          <a class="dashboard-card-link photo-modal-link" data-photo-journal hidden>Открыть в журнале</a>
        </div>
      </div>
    </div>
  </section>
</div>
<script src="/public/app.js"></script>
  </body>
</html>
