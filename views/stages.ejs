<%- include('partials/head', { pageTitle }) %>
<% const selected = stages.selectedCard; %>
<% const formatCountValue = (value) => value === 0 || value === '0' ? '0' : (value || '?'); %>
<% const selectedEmployee = (stages.employees || []).find((item) => item.key === stages.selectedEmployee); %>
<% const selectedStatus = (stages.statuses || []).find((item) => item.key === stages.selectedStatus); %>
<% const selectedStage = (stages.stages || []).find((item) => item.key === stages.selectedStage); %>
<% const summaryParts = [selectedEmployee ? selectedEmployee.label : 'Все сотрудники', selectedStatus && stages.selectedStatus !== 'all' ? selectedStatus.label : 'Все статусы'].filter(Boolean); %>
<% const clearStagesUrl = () => {
  const params = new URLSearchParams();
  if (stages.selectedReportId) params.set('reportId', stages.selectedReportId);
  return `/stages${params.toString() ? `?${params.toString()}` : ''}`;
}; %>
<% const stagesUrl = (updates = {}) => {
  const params = new URLSearchParams();
  const values = { q: stages.search, stage: stages.selectedStage, employee: stages.selectedEmployee, status: stages.selectedStatus, reportId: stages.selectedReportId, ...updates };
  if (values.q) params.set('q', values.q);
  if (values.stage && values.stage !== 'all') params.set('stage', values.stage);
  if (values.employee && values.employee !== 'all') params.set('employee', values.employee);
  if (values.status && values.status !== 'all') params.set('status', values.status);
  if (values.reportId) params.set('reportId', values.reportId);
  if (values.batchId) params.set('batchId', values.batchId);
  if (values.tab) params.set('tab', values.tab);
  if (values.eventId) params.set('eventId', values.eventId);
  return `/stages${params.toString() ? `?${params.toString()}` : ''}`;
}; %>
<div class="app-shell">
  <%- include('partials/sidebar', { activePage: 'stages', showDashboardLink }) %>

  <main class="app-main app-main-stages">
    <section class="batches-page">
      <div class="batches-layout">
        <aside class="batches-browser">
          <div class="batches-browser-head global-journal-hero app-page-hero">
            <div>
              <h1>Партии</h1>
            </div>
            <span class="batches-total"><%= stages.cards.length %></span>
          </div>

          <div class="batches-toolbar">
            <form class="batches-search" method="get" action="/stages">
              <input id="batch-search" name="q" value="<%= stages.search %>" placeholder="По коду, культуре, виду или сорту" autocomplete="off">
              <% if (stages.selectedReportId) { %><input type="hidden" name="reportId" value="<%= stages.selectedReportId %>"><% } %>
              <% if (stages.selectedStage !== 'all') { %><input type="hidden" name="stage" value="<%= stages.selectedStage %>"><% } %>
              <% if (stages.selectedEmployee !== 'all') { %><input type="hidden" name="employee" value="<%= stages.selectedEmployee %>"><% } %>
              <% if (stages.selectedStatus !== 'all') { %><input type="hidden" name="status" value="<%= stages.selectedStatus %>"><% } %>
            </form>

            <div class="batches-filter-row">
            <div class="batches-filter" data-batches-filter>
              <button type="button" class="batches-filter-toggle <%= stages.selectedEmployee !== 'all' ? 'has-value' : '' %>" data-batches-filter-toggle aria-expanded="false">
                <span class="batches-filter-toggle-copy">Сотрудники</span>
              </button>
            <nav class="batches-filter-menu" data-batches-filter-menu hidden aria-label="Фильтр по сотрудникам">
              <% stages.employees.forEach((item) => { %>
                <a class="batches-stage-filter-item <%= stages.selectedEmployee === item.key ? 'active' : '' %>" href="<%= stagesUrl({ employee: item.key }) %>">
                  <span><%= item.label %></span>
                  <strong><%= item.count %></strong>
                </a>
              <% }) %>
            </nav>
            </div>

            <div class="batches-filter" data-batches-filter>
              <button type="button" class="batches-filter-toggle <%= stages.selectedStage !== 'all' ? 'has-value' : '' %>" data-batches-filter-toggle aria-expanded="false">
                <span class="batches-filter-toggle-copy">Стадии</span>
              </button>
            <nav class="batches-filter-menu" data-batches-filter-menu hidden aria-label="Фильтр по стадиям">
              <% stages.stages.forEach((item) => { %>
                <a class="batches-stage-filter-item <%= stages.selectedStage === item.key ? 'active' : '' %>" href="<%= stagesUrl({ stage: item.key }) %>">
                  <span><%= item.label %></span>
                  <strong><%= item.count %></strong>
                </a>
              <% }) %>
            </nav>
            </div>

            <div class="batches-filter" data-batches-filter>
              <button type="button" class="batches-filter-toggle <%= stages.selectedStatus !== 'all' ? 'has-value' : '' %>" data-batches-filter-toggle aria-expanded="false">
                <span class="batches-filter-toggle-copy">Статус</span>
              </button>
            <nav class="batches-filter-menu" data-batches-filter-menu hidden aria-label="Фильтр по статусу">
              <% stages.statuses.forEach((item) => { %>
                <a class="batches-stage-filter-item <%= stages.selectedStatus === item.key ? 'active' : '' %>" href="<%= stagesUrl({ status: item.key }) %>">
                  <span><%= item.label %></span>
                  <strong><%= item.count %></strong>
                </a>
              <% }) %>
            </nav>
            </div>
            </div>
          </div>
          <div class="batches-selected-stage-head">
            <div>
              <h2 class="batches-selected-stage-title"><%= selectedStage ? selectedStage.label : 'Все партии' %></h2>
              <p><%= summaryParts.join(' • ') %></p>
            </div>
            <% if (stages.hasActiveFilters) { %>
              <a class="batches-reset-link" href="<%= clearStagesUrl() %>">Сбросить фильтры</a>
            <% } %>
          </div>

          <div class="batches-list" aria-label="Список партий">
            <% if (stages.cards.length) { %>
              <% stages.cards.forEach((card) => { %>
                <a class="batch-list-card <%= selected && selected.batchKey === card.batchKey ? 'active' : '' %>" <%= selected && selected.batchKey === card.batchKey ? 'data-selected-batch' : '' %> href="<%= stagesUrl({ batchId: card.batchKey }) %>">
                  <span class="batch-list-copy">
                    <strong><%= card.title %></strong>
                    <small><%= card.code %> · <%= card.stage %></small>
                    <span class="batch-list-meta">
                      <span>Остаток: <%= formatCountValue(card.currentQuantity) %> шт.</span>
                      <% if (Number(card.daysInStage) > 0) { %><span>Дней на стадии: <%= card.daysInStage %></span><% } %>
                    </span>
                    <span class="batch-list-status batch-list-status-<%= card.visualStatusTone %>"><%= card.visualStatusLabel %></span>
                  </span>
                </a>
              <% }) %>
            <% } else { %>
              <div class="empty-state batches-empty-list"><h2>Партии не найдены</h2><p>Измените параметры поиска или фильтры.</p></div>
            <% } %>
          </div>
        </aside>

        <section class="batch-detail-shell">
          <% if (!selected) { %>
            <div class="batch-empty-state">
              <div class="batch-empty-icon">🌿</div>
              <h2>Выберите партию слева</h2>
              <p>Здесь появятся календарь, паспорт и журнал выбранной партии.</p>
            </div>
          <% } else { %>
            <header class="batch-detail-header">
              <div>
                <h2><%= selected.title %></h2>
                <div class="batch-detail-meta">
                  <span><%= selected.stage %></span>
                </div>
              </div>
            </header>

            <nav class="batch-tabs" aria-label="Разделы партии">
              <a class="<%= stages.selectedTab === 'passport' ? 'active' : '' %>" data-tab="passport" href="<%= stagesUrl({ batchId: stages.selectedBatchKey, tab: 'passport', eventId: '' }) %>#passport">Паспорт</a>
              <a class="<%= stages.selectedTab === 'journal' ? 'active' : '' %>" data-tab="journal" href="<%= stagesUrl({ batchId: stages.selectedBatchKey, tab: 'journal', eventId: stages.highlightedEventId }) %>#journal">Журнал</a>
            </nav>

            <div class="batch-detail-content">
              <section class="batch-tab-panel" id="passport">
                <div class="passport-grid">
                  <article><h4>Сводка</h4><dl><dt>Статус партии</dt><dd><%= selected.statusLabel %></dd><dt>Общий остаток</dt><dd><%= selected.totalQuantityLabel %></dd><% if (selected.originType === 'problemIsolation') { %><% if (selected.healthStatusLabel) { %><dt>Состояние здоровья</dt><dd><%= selected.healthStatusLabel %></dd><% } %><% if (selected.isolationStatusLabel) { %><dt>Статус изоляции</dt><dd><%= selected.isolationStatusLabel %></dd><% } %><% if (Number(selected.activeProblemQuantity) > 0) { %><dt>С активной проблемой</dt><dd><%= selected.activeProblemQuantity %> шт.</dd><% } %><% } else { %><% if (Number(selected.activeProblemQuantity) > 0) { %><dt>Здоровые</dt><dd><%= selected.healthyQuantity %> шт.</dd><dt>С активной проблемой</dt><dd><%= selected.activeProblemQuantity %> шт.</dd><% } %><% if (Number(selected.unisolatedProblemQuantity) > 0) { %><dt>Без изоляции</dt><dd><%= selected.unisolatedProblemQuantity %> шт.</dd><% } %><% if (selected.healthStatusLabel) { %><dt>Состояние здоровья</dt><dd><%= selected.healthStatusLabel %></dd><% } %><% if (selected.isolationStatusLabel) { %><dt>Статус изоляции</dt><dd><%= selected.isolationStatusLabel %></dd><% } %><% } %><% if (Number(selected.propagationQuantity) > 0) { %><dt>Исходные растения</dt><dd><%= formatCountValue(selected.sourceQuantity) %> шт.</dd><dt>Размножено</dt><dd><%= selected.propagationQuantity %> шт.</dd><% } %><% if (selected.code) { %><dt>QR-код</dt><dd><%= selected.qrStatusLabel %></dd><% } %><dt>Дней на стадии</dt><dd><%= selected.daysInStage %></dd></dl></article>
                  <article><h4>Размещение</h4><dl><dt>Местоположение</dt><dd><%= selected.location || '—' %></dd></dl></article>
                  <% if (selected.originType === 'cloned' || selected.originType === 'problemIsolation') { %>
                    <article><h4>Происхождение</h4><dl><dt>Тип партии</dt><dd><%= selected.originLabel || (selected.originType === 'problemIsolation' ? 'Изолированная партия' : 'Клон') %></dd><dt>Родительская партия</dt><dd><%= selected.parentCode || '—' %></dd><% if (selected.generation || selected.generation === 0 || selected.generation === '0') { %><dt>Поколение</dt><dd><%= selected.generation === 0 || selected.generation === '0' ? '0' : (selected.generation || 1) %></dd><% } %><% if (selected.propagationMethod) { %><dt>Способ размножения</dt><dd><%= selected.propagationMethod %></dd><% } %><% if (selected.sourceProblemEventId) { %><dt>Источник проблемы</dt><dd><%= selected.sourceProblemEventId %></dd><% } %><% if (selected.propagatedAt) { %><dt>Дата размножения</dt><dd><%= new Intl.DateTimeFormat('ru-RU', { day: '2-digit', month: '2-digit', year: 'numeric' }).format(new Date(selected.propagatedAt)) %></dd><% } %></dl></article>
                  <% } %>
                  <% if (selected.parentBatch || (selected.childBatches && selected.childBatches.length)) { %>
                    <article><h4>Связи партии</h4><dl><% if (selected.parentBatch) { %><dt>Родитель</dt><dd><a href="<%= stagesUrl({ batchId: selected.parentBatch.batchKey }) %>"><%= selected.parentBatch.code %></a></dd><% } %><% if (selected.childBatches && selected.childBatches.length) { %><dt>Дочерние партии</dt><dd><% selected.childBatches.forEach((child, index) => { %><a href="<%= stagesUrl({ batchId: child.batchKey }) %>"><%= child.code %></a><%= index < selected.childBatches.length - 1 ? ', ' : '' %><% }) %></dd><% } %></dl></article>
                  <% } %>
                  <% if (selected.problemType || selected.riskLevel || selected.problemDescription) { %>
                    <article><h4>Проблема</h4><dl><% if (selected.problemType) { %><dt>Тип проблемы</dt><dd><%= selected.problemType %></dd><% } %><% if (selected.riskLevel) { %><dt>Риск</dt><dd><%= selected.riskLevel %></dd><% } %><% if (selected.problemDescription) { %><dt>Описание</dt><dd><%= selected.problemDescription %></dd><% } %></dl></article>
                  <% } %>
                  <article><h4>Культура</h4><dl><dt>Культура</dt><dd><%= selected.culture || '—' %></dd><dt>Вид</dt><dd><%= selected.species || '—' %></dd><dt>Сорт</dt><dd><%= selected.variety || '—' %></dd></dl></article>
                  <article><h4>История</h4><dl><dt>Дата создания</dt><dd><%= selected.createdAt ? new Intl.DateTimeFormat('ru-RU', { day: '2-digit', month: '2-digit', year: 'numeric' }).format(new Date(selected.createdAt)) : '—' %></dd><dt>Код партии</dt><dd><%= selected.code %></dd><% if (selected.stageChangedAt) { %><dt>Дата перехода в стадию <%= selected.stage %></dt><dd><%= new Intl.DateTimeFormat('ru-RU', { day: '2-digit', month: '2-digit', year: 'numeric' }).format(new Date(selected.stageChangedAt)) %></dd><% } %></dl></article>
                </div>
              </section>

              <section class="batch-tab-panel" id="journal">
                <% const batchJournalDateFormatter = new Intl.DateTimeFormat('ru-RU', { day: 'numeric', month: 'long', year: 'numeric' }); %>
                <% const batchJournalTimeFormatter = new Intl.DateTimeFormat('ru-RU', { hour: '2-digit', minute: '2-digit' }); %>
                <% const batchJournalGroups = []; %>
                <% const batchJournalGroupMap = new Map(); %>
                <% selected.events.forEach((event) => {
                  const eventDate = event.createdAt ? new Date(event.createdAt) : null;
                  const hasValidDate = eventDate && !Number.isNaN(eventDate.getTime());
                  const dateKey = hasValidDate ? `${eventDate.getFullYear()}-${eventDate.getMonth()}-${eventDate.getDate()}` : 'unknown';
                  const dateLabel = hasValidDate ? batchJournalDateFormatter.format(eventDate) : 'Дата не указана';
                  const timeLabel = hasValidDate ? batchJournalTimeFormatter.format(eventDate) : '—';
                  let group = batchJournalGroupMap.get(dateKey);
                  if (!group) {
                    group = { key: dateKey, label: dateLabel, events: [] };
                    batchJournalGroupMap.set(dateKey, group);
                    batchJournalGroups.push(group);
                  }
                  group.events.push({ event, timeLabel });
                }); %>
                <div class="batch-journal-list">
                  <% batchJournalGroups.forEach((group) => { %>
                    <section class="batch-journal-date-group">
                      <h3 class="batch-journal-date"><%= group.label %></h3>
                      <% group.events.forEach(({ event, timeLabel }) => { %><article data-event-id="<%= event.eventId %>"><time><%= timeLabel %></time><div><strong><%= event.title %></strong>
                        <% if (event.details.length) { %><dl class="batch-event-details"><% event.details.forEach((item) => { %><dt><%= item.label %></dt><dd><%= item.value %></dd><% }) %></dl><% } %>
                        <% if (event.photos && event.photos.length) { %>
                          <div class="global-journal-photos">
                            <% event.photos.forEach((photo, photoIndex) => { const photoUrl = `/reports/${encodeURIComponent(selected.reportId)}/photos/${photo.split('/').map(encodeURIComponent).join('/')}`; %>
                              <button type="button" class="global-journal-photo" data-photo-url="<%= photoUrl %>" data-photo-label="<%= event.title %>, <%= selected.code %>">
                                <img src="<%= photoUrl %>" alt="Фото события <%= photoIndex + 1 %>" />
                              </button>
                            <% }) %>
                          </div>
                        <% } %>
                        </div></article><% }) %>
                    </section>
                  <% }) %>
                </div>
              </section>
            </div>
          <% } %>
        </section>
      </div>
    </section>
  </main>
</div>
<%- include('partials/footer') %>
