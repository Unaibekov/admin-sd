<%- include('partials/head', { pageTitle }) %>
<div class="app-shell">
  <%- include('partials/sidebar', { activePage: dashboard.hasReports ? 'dashboard' : 'upload', showDashboardLink: dashboard.hasReports }) %>

  <main class="app-main <%= dashboard.hasReports ? 'app-main-dashboard' : 'app-main-upload' %>">
    <% if (flashMessage) { %><div class="alert alert-success dashboard-flash"><%= flashMessage %></div><% } %>

    <% if (!dashboard.hasReports) { %>
      <section class="dashboard-empty-copy">
        <p class="eyebrow">Дашборд</p>
        <h1>Нет данных для дашборда</h1>
        <p>Загрузите первый ZIP-отчет из Sadovnik Diary.</p>
        <a class="button button-primary" href="/upload">Загрузить отчет</a>
      </section>
    <% } else { %>
      <% const dashboardUrl = (period) => {
        const params = new URLSearchParams();
        if (dashboard.selectedReportId) params.set('reportId', dashboard.selectedReportId);
        params.set('period', period);
        return `/?${params.toString()}`;
      }; %>
      <% const dashboardJournalUrl = (extra = {}) => {
        const params = new URLSearchParams();
        if (dashboard.selectedReportId) params.set('reportId', dashboard.selectedReportId);
        Object.entries(extra).forEach(([key, value]) => {
          if (value !== undefined && value !== null && value !== '') params.set(key, value);
        });
        return `/journal${params.toString() ? `?${params.toString()}` : ''}`;
      }; %>
      <% const dashboardReportsUrl = () => {
        if (!dashboard.selectedReportId) return '/reports';
        const selectedReport = dashboard.selectedReportSummary
          || (dashboard.recentReports || []).find((report) => report.reportId === dashboard.selectedReportId)
          || dashboard.recentReports[0];
        return selectedReport ? `/reports?employee=${encodeURIComponent(selectedReport.employeeKey)}&reportId=${encodeURIComponent(selectedReport.reportId)}` : '/reports';
      }; %>
      <% const dashboardPhotosUrl = () => dashboard.selectedReportId
        ? `/photos?reportId=${encodeURIComponent(dashboard.selectedReportId)}`
        : '/photos'; %>
      <section class="dashboard-page" data-dashboard-page>
        <div class="dashboard-shell">
          <header class="dashboard-overview-head">
            <div>
              <h1>Дашборд</h1>
              <p>Текущее состояние партий и активность команды.</p>
            </div>
            <nav class="dashboard-period-switcher" aria-label="Период дашборда">
              <% dashboard.periodOptions.forEach((option) => { %>
                <a href="<%= dashboardUrl(option.value) %>" class="<%= dashboard.period.key === option.value ? 'active' : '' %>"><%= option.label %></a>
              <% }) %>
            </nav>
          </header>

          <section class="dashboard-stats dashboard-stats-top" aria-label="Основные показатели">
            <%- include('partials/dashboard-kpis', { metrics: dashboard.topMetrics }) %>
          </section>

          <section class="dashboard-layout">
            <article class="dashboard-card dashboard-recent-events-card">
              <div class="dashboard-card-head">
                <div><h2>Последние события</h2><p>Действия сотрудников за период</p></div>
                <a class="dashboard-card-link" href="<%= dashboardJournalUrl() %>">Показать все</a>
              </div>
              <%- include('partials/dashboard-event-feed', {
                events: dashboard.recentEvents.slice(0, 5),
                emptyText: 'За выбранный период событий нет.',
                eventHref: (event) => event.batchKey ? `/stages?batchId=${encodeURIComponent(event.batchKey)}${dashboard.selectedReportId ? `&reportId=${encodeURIComponent(dashboard.selectedReportId)}` : ''}&tab=journal${event.eventId ? `&eventId=${encodeURIComponent(event.eventId)}` : ''}#journal` : ''
              }) %>
            </article>

            <article class="dashboard-card">
              <div class="dashboard-card-head"><div><h2>Проблемные партии</h2><p>Требуют внимания сейчас</p></div><a class="dashboard-card-link" href="<%= dashboardJournalUrl({ category: 'problems' }) %>">Все проблемы</a></div>
              <%- include('partials/dashboard-event-feed', {
                events: dashboard.attentionEvents.slice(0, 5),
                feedClass: 'dashboard-attention-list',
                forceAttention: true,
                emptyText: 'Нет партий, требующих внимания.',
                eventHref: (event) => event.batchKey ? `/stages?batchId=${encodeURIComponent(event.batchKey)}${dashboard.selectedReportId ? `&reportId=${encodeURIComponent(dashboard.selectedReportId)}` : ''}&tab=journal${event.eventId ? `&eventId=${encodeURIComponent(event.eventId)}` : ''}#journal` : ''
              }) %>
            </article>
          </section>

          <section class="dashboard-grid dashboard-grid-secondary">
            <article class="dashboard-card dashboard-reports-card">
              <div class="dashboard-card-head"><div><h2>Последние отчеты</h2><p>Последний импорт каждого сотрудника</p></div><a href="<%= dashboardReportsUrl() %>" class="dashboard-card-link">Все отчеты</a></div>
              <% if (dashboard.recentReports.length) { %>
                <div class="dashboard-reports">
                  <% dashboard.recentReports.forEach((report) => { const reportHref = `/reports?employee=${encodeURIComponent(report.employeeKey)}&reportId=${encodeURIComponent(report.reportId)}`; %><a class="dashboard-report-row" href="<%= reportHref %>"><div class="dashboard-report-main"><div class="dashboard-report-headline"><strong><%= report.author %></strong><div class="dashboard-report-meta"><span><%= report.role %> &middot; <%= report.displayCreatedAt %></span></div></div><div class="dashboard-report-pills"><span><%= report.summary.cardsCountLabel %></span><span><%= report.summary.eventsCountLabel %></span><span><%= report.summary.photosCountLabel %></span><span><%= report.summary.problemsCountLabel %></span></div></div></a><% }) %>
                </div>
              <% } else { %><div class="dashboard-inline-empty">За выбранный период отчетов нет.</div><% } %>
            </article>

            <article class="dashboard-card dashboard-gallery-card">
              <div class="dashboard-card-head"><div><h2>Последние фотофиксации</h2><p>Недавние визуальные фиксации по событиям за период</p></div><a href="<%= dashboardPhotosUrl() %>" class="dashboard-card-link">Все фотофиксации</a></div>
              <%- include('partials/dashboard-gallery', { photos: dashboard.recentPhotos, emptyText: 'За выбранный период фотофиксаций нет.', compact: true }) %>
            </article>
          </section>

          <% const metrics = Object.values(dashboard.productionMetrics); %>
          <% if (metrics.length) { %>
            <section class="dashboard-production" aria-label="Производственные показатели"><div><h2>Производственные показатели</h2><p>За период: <%= dashboard.period.label %></p></div><div class="dashboard-production-list"><% metrics.forEach((metric) => { %><article><span><%= metric.label %></span><strong><%= metric.value %> <small><%= metric.unit %></small></strong></article><% }) %></div></section>
          <% } %>
        </div>
      </section>
    <% } %>
  </main>
</div>
<%- include('partials/footer') %>



