<%- include('partials/head', { pageTitle }) %>
<% const filters = journal.filters; %>
<% const selectedAuthor = (journal.employeeOptions || []).find((option) => option.value === filters.employee) || { label: 'Все сотрудники' }; %>
<% const selectedCategory = (journal.categoryOptions || []).find((option) => option.value === filters.category) || { label: 'Все события' }; %>
<div class="app-shell">
  <%- include('partials/sidebar', { activePage: 'journal', showDashboardLink }) %>

  <main class="app-main app-main-journal" data-global-journal-page>
      <header class="global-journal-hero">
        <h1>Журнал</h1>
        <% if (journal.hasEvents) { %>
          <section class="global-journal-summary" aria-label="Сводка по найденным событиям">
            <span>Найдено действий: <strong><%= journal.summary.total %></strong></span>
            <span>Проблемных действий: <strong><%= journal.summary.problems %></strong></span>
            <span>Потеряно растений: <strong><%= journal.summary.lostPlants %></strong></span>
            <span>Продано растений: <strong><%= journal.summary.soldPlants %></strong></span>
            <span>Действий с фото: <strong><%= journal.summary.photos %></strong></span>
          </section>
        <% } %>
      </header>

      <section class="global-journal-layout">
        <aside class="global-journal-filter-panel">
          <h2>Фильтры</h2>
          <form class="global-journal-filters" method="get" action="/journal">
            <% if (journal.selectedReportId) { %><input type="hidden" name="reportId" value="<%= journal.selectedReportId %>"><% } %>
            <label class="global-journal-period">
              <span>Период</span>
              <div class="batches-filter global-journal-dropdown" data-global-journal-filter>
                <input type="hidden" name="period" value="<%= filters.period %>" data-global-journal-period data-global-journal-filter-input>
                <button type="button" class="batches-filter-toggle <%= filters.period !== 'all' ? 'has-value' : '' %>" data-global-journal-filter-toggle aria-expanded="false">
                  <span class="batches-filter-toggle-copy" data-global-journal-filter-label>
                    <%= (journal.periodOptions.find((option) => option.value === filters.period) || journal.periodOptions[0]).label %>
                  </span>
                </button>
                <nav class="batches-filter-menu" data-global-journal-filter-menu hidden aria-label="Фильтр по периоду">
                  <% journal.periodOptions.forEach((option) => { %>
                    <button
                      type="button"
                      class="batches-stage-filter-item <%= filters.period === option.value ? 'active' : '' %>"
                      data-global-journal-filter-option
                      data-value="<%= option.value %>"
                      data-label="<%= option.label %>">
                      <span><%= option.label %></span>
                    </button>
                  <% }) %>
                </nav>
              </div>
            </label>

            <div class="global-journal-custom-range" data-global-journal-custom-range <%= filters.period === 'custom' ? '' : 'hidden' %>>
              <label>
                <span>С</span>
                <input type="date" name="dateFrom" value="<%= filters.dateFrom %>" data-global-journal-date />
              </label>
              <label>
                <span>По</span>
                <input type="date" name="dateTo" value="<%= filters.dateTo %>" data-global-journal-date />
              </label>
            </div>

            <label>
              <span>Сотрудник</span>
              <div class="batches-filter global-journal-dropdown" data-global-journal-filter>
                <input type="hidden" name="employee" value="<%= filters.employee %>" data-global-journal-filter-input>
                <button type="button" class="batches-filter-toggle <%= filters.employee !== 'all' ? 'has-value' : '' %>" data-global-journal-filter-toggle aria-expanded="false">
                  <span class="batches-filter-toggle-copy" data-global-journal-filter-label>
                    <%= (journal.employeeOptions.find((option) => option.value === filters.employee) || journal.employeeOptions[0]).label %>
                  </span>
                </button>
                <nav class="batches-filter-menu global-journal-dropdown-menu-scroll" data-global-journal-filter-menu hidden aria-label="Фильтр по сотруднику">
                  <% journal.employeeOptions.forEach((option) => { %>
                    <button
                      type="button"
                      class="batches-stage-filter-item <%= filters.employee === option.value ? 'active' : '' %>"
                      data-global-journal-filter-option
                      data-value="<%= option.value %>"
                      data-label="<%= option.label %>">
                      <span><%= option.label %></span>
                    </button>
                  <% }) %>
                </nav>
              </div>
            </label>

            <label>
              <span>Быстрый фильтр</span>
              <div class="batches-filter global-journal-dropdown" data-global-journal-filter>
                <input type="hidden" name="quick" value="<%= filters.quick %>" data-global-journal-filter-input>
                <button type="button" class="batches-filter-toggle <%= filters.quick !== 'all' ? 'has-value' : '' %>" data-global-journal-filter-toggle aria-expanded="false">
                  <span class="batches-filter-toggle-copy" data-global-journal-filter-label>
                    <%= (journal.quickOptions.find((option) => option.value === filters.quick) || journal.quickOptions[0]).label %>
                  </span>
                </button>
                <nav class="batches-filter-menu" data-global-journal-filter-menu hidden aria-label="Быстрый фильтр">
                  <% journal.quickOptions.forEach((option) => { %>
                    <button
                      type="button"
                      class="batches-stage-filter-item <%= filters.quick === option.value ? 'active' : '' %>"
                      data-global-journal-filter-option
                      data-value="<%= option.value %>"
                      data-label="<%= option.label %>">
                      <span><%= option.label %></span>
                    </button>
                  <% }) %>
                </nav>
              </div>
            </label>

            <label>
              <span>Тип события</span>
              <div class="batches-filter global-journal-dropdown" data-global-journal-filter>
                <input type="hidden" name="category" value="<%= filters.category %>" data-global-journal-filter-input>
                <button type="button" class="batches-filter-toggle <%= filters.category !== 'all' ? 'has-value' : '' %>" data-global-journal-filter-toggle aria-expanded="false">
                  <span class="batches-filter-toggle-copy" data-global-journal-filter-label>
                    <%= (journal.categoryOptions.find((option) => option.value === filters.category) || journal.categoryOptions[0]).label %>
                  </span>
                </button>
                <nav class="batches-filter-menu" data-global-journal-filter-menu hidden aria-label="Фильтр по типу события">
                  <% journal.categoryOptions.forEach((option) => { %>
                    <button
                      type="button"
                      class="batches-stage-filter-item <%= filters.category === option.value ? 'active' : '' %>"
                      data-global-journal-filter-option
                      data-value="<%= option.value %>"
                      data-label="<%= option.label %>">
                      <span><%= option.label %></span>
                    </button>
                  <% }) %>
                </nav>
              </div>
            </label>

            <label>
              <span>Стадия</span>
              <div class="batches-filter global-journal-dropdown" data-global-journal-filter>
                <input type="hidden" name="stage" value="<%= filters.stage %>" data-global-journal-filter-input>
                <button type="button" class="batches-filter-toggle <%= filters.stage !== 'all' ? 'has-value' : '' %>" data-global-journal-filter-toggle aria-expanded="false">
                  <span class="batches-filter-toggle-copy" data-global-journal-filter-label>
                    <%= (journal.stageOptions.find((option) => option.value === filters.stage) || journal.stageOptions[0]).label %>
                  </span>
                </button>
                <nav class="batches-filter-menu" data-global-journal-filter-menu hidden aria-label="Фильтр по стадии">
                  <% journal.stageOptions.forEach((option) => { %>
                    <button
                      type="button"
                      class="batches-stage-filter-item <%= filters.stage === option.value ? 'active' : '' %>"
                      data-global-journal-filter-option
                      data-value="<%= option.value %>"
                      data-label="<%= option.label %>">
                      <span><%= option.label %></span>
                    </button>
                  <% }) %>
                </nav>
              </div>
            </label>

            <label class="global-journal-search">
              <span>Партия</span>
              <input type="search" name="q" value="<%= filters.query %>" placeholder="Код, культура, вид или сорт" />
            </label>

            <button class="global-journal-apply" type="submit">Показать</button>
          </form>
        </aside>

        <section class="global-journal-results">
          <% if (journal.hasEvents) { %>
            <header class="global-journal-results-head">
              <strong><%= selectedCategory.label %></strong>
              <span><%= selectedAuthor.label %></span>
            </header>
          <% } %>

          <% if (journal.hasEvents) { %>
            <% if (journal.hasResults) { %>
              <section class="global-journal-timeline" aria-label="Хронология событий">
                <% journal.cardGroups.forEach((group) => { %>
                  <details class="global-journal-plant-card">
                    <summary class="global-journal-plant-summary">
                      <span class="global-journal-plant-head">
                        <span class="global-journal-plant-title"><%= group.title %></span>
                        <span class="global-journal-plant-stage"><%= group.stage %></span>
                        <span class="global-journal-event-meta">
                          <% if (group.quantityLabel) { %><span>Остаток: <%= group.quantityLabel %></span><% } %>
                          <% if (group.daysInStageLabel) { %><span>Дней на стадии: <%= group.daysInStageLabel %></span><% } %>
                        </span>
                      </span>
                    </summary>

                    <div class="global-journal-events">
                      <% group.events.forEach((event, eventIndex) => { %>
                        <article class="global-journal-event global-journal-event-<%= event.category %>">
                          <time datetime="<%= event.date %>"><%= event.timeLabel %></time>
                          <div class="global-journal-event-body">
                            <div class="global-journal-event-topline">
                              <h3><%= event.title %></h3>
                              <% if (event.isImportant) { %><span class="global-journal-important">Важно</span><% } %>
                            </div>

                            <% const globalJournalEventDetails = event.comment ? [...event.details, { label: 'Комментарий', value: event.comment }] : event.details; %>
                            <% if (globalJournalEventDetails.length) { %>
                              <dl class="global-journal-details">
                                <% globalJournalEventDetails.forEach((item) => { %>
                                  <dt><%= item.label %></dt>
                                  <dd><%= item.value %></dd>
                                <% }) %>
                              </dl>
                            <% } %>

                            <% if (event.photos.length) { %>
                              <dl class="global-journal-details global-journal-details-photos">
                                <dt>Фото</dt>
                                <dd>
                                  <div class="global-journal-photos">
                                    <% event.photos.forEach((photo, photoIndex) => { %>
                                      <button type="button" class="global-journal-photo" data-photo-url="<%= photo %>" data-photo-label="<%= event.title %>, <%= event.code %>">
                                        <img src="<%= photo %>" alt="Фото события <%= photoIndex + 1 %>" />
                                      </button>
                                    <% }) %>
                                  </div>
                                </dd>
                              </dl>
                            <% } %>
                          </div>
                        </article>
                        <% if (eventIndex < group.events.length - 1) { %><hr class="global-journal-event-divider"><% } %>
                      <% }) %>

                      <% if (group.batchUrl) { %>
                        <a class="global-journal-batch-link" href="<%= group.batchUrl %>">Открыть партию</a>
                      <% } %>
                    </div>
                  </details>
                <% }) %>
              </section>
            <% } else { %>
              <section class="empty-state global-journal-empty">
                <h2>Ничего не найдено</h2>
                <p>Попробуйте изменить период или фильтры.</p>
              </section>
            <% } %>
          <% } else { %>
            <section class="empty-state global-journal-empty">
              <h2>Пока нет событий</h2>
              <p>Они появятся после загрузки отчётов из Sadovnik Diary.</p>
            </section>
          <% } %>
        </section>
      </section>
  </main>
</div>
<%- include('partials/footer') %>
